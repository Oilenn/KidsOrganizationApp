<UserControl x:Class="KidsOrganizationApp.UI.View.AddFamilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Visibility="{Binding ChildFieldsVisibility}">
                    <TextBlock Text="Данные ребёнка" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" Margin="0,0,0,12" />
                    <TextBlock Text="Имя *" />
                    <TextBox Text="{Binding ChildName}" Margin="0,4,0,10" />
                    <TextBlock Text="Фамилия *" />
                    <TextBox Text="{Binding ChildSurname}" Margin="0,4,0,10" />
                    <TextBlock Text="Отчество" />
                    <TextBox Text="{Binding ChildPatronymic}" Margin="0,4,0,10" />
                    <TextBlock Text="Телефон *" />
                    <TextBox Text="{Binding ChildPhone}" Margin="0,4,0,10" />
                    <TextBlock Text="Место жительства *" />
                    <TextBox Text="{Binding ChildLivingPlace}" Margin="0,4,0,10" />
                    <TextBlock Text="Дата рождения *" />
                    <DatePicker SelectedDate="{Binding ChildBirthDate}" Margin="0,4,0,10" />
                </StackPanel>

                <StackPanel Visibility="{Binding ParentFieldsVisibility}">
                    <TextBlock Text="Данные родителя или законного представителя" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Имя *" />
                    <TextBox Text="{Binding ParentName}" Margin="0,4,0,10" />
                    <TextBlock Text="Фамилия *" />
                    <TextBox Text="{Binding ParentSurname}" Margin="0,4,0,10" />
                    <TextBlock Text="Отчество" />
                    <TextBox Text="{Binding ParentPatronymic}" Margin="0,4,0,10" />
                    <TextBlock Text="Телефон *" />
                    <TextBox Text="{Binding ParentPhone}" Margin="0,4,0,10" />
                    <TextBlock Text="Место жительства *" />
                    <TextBox Text="{Binding ParentLivingPlace}" Margin="0,4,0,10" />
                    <TextBlock Text="Дата рождения *" />
                    <DatePicker SelectedDate="{Binding ParentBirthDate}" Margin="0,4,0,10" />
                </StackPanel>

                <Separator Margin="0,12" />
                <TextBlock Text="Документы" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentText}" Margin="0,0,0,8" />
                <TextBlock Text="Тип документа" />
                <ComboBox ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedDocumentType}" Margin="0,4,0,10" />
                <TextBlock Text="Файл документа" />
                <DockPanel Margin="0,4,0,10">
                    <Button Content="Выбрать файл" Command="{Binding SelectDocumentCommand}"
                            DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding DocumentPath}" IsReadOnly="True" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Добавить файл к записи" Command="{Binding AddDocumentCommand}" />
                    <Button Content="Убрать выбранный" Command="{Binding RemoveDocumentCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding PendingDocuments}" SelectedItem="{Binding SelectedPendingDocument}"
                         DisplayMemberPath="Name" Height="96" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</UserControl>
