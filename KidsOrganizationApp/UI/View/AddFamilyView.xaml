<Window x:Class="KidsOrganizationApp.UI.View.AddFamilyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KidsOrganizationApp.UI.View"
        mc:Ignorable="d"
        Title="Добавление семьи" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ребенок -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="РЕБЕНОК" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Text="Имя:" FontWeight="Bold" Margin="0,5"/>
        <TextBox Grid.Column="0" Grid.Row="2" Text="{Binding ChildName, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Text="Фамилия:" FontWeight="Bold" Margin="0,5"/>
        <TextBox Grid.Column="0" Grid.Row="4" Text="{Binding ChildSurname, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="0" Grid.Row="5" Text="Отчество:" FontWeight="Bold" Margin="0,5"/>
        <TextBox Grid.Column="0" Grid.Row="6" Text="{Binding ChildPatronymic, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="0" Grid.Row="7" Text="Телефон:" FontWeight="Bold" Margin="0,5"/>
        <TextBox Grid.Column="0" Grid.Row="8" Text="{Binding ChildPhone, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="0" Grid.Row="9" Text="Место жительства:" FontWeight="Bold" Margin="0,5"/>
        <TextBox Grid.Column="0" Grid.Row="10" Text="{Binding ChildLivingPlace, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="0" Grid.Row="11" Text="Дата рождения:" FontWeight="Bold" Margin="0,5"/>
        <DatePicker Grid.Column="0" Grid.Row="12" SelectedDate="{Binding ChildBirthDate}" 
                    Margin="0,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <!-- Родитель -->
        <TextBlock Grid.Column="1" Grid.Row="0" Text="РОДИТЕЛЬ" FontWeight="Bold" FontSize="16" Margin="20,0,0,10"/>

        <TextBlock Grid.Column="1" Grid.Row="1" Text="Имя:" FontWeight="Bold" Margin="20,5,0,5"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding ParentName, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="1" Grid.Row="3" Text="Фамилия:" FontWeight="Bold" Margin="20,5,0,5"/>
        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding ParentSurname, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="1" Grid.Row="5" Text="Отчество:" FontWeight="Bold" Margin="20,5,0,5"/>
        <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding ParentPatronymic, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="1" Grid.Row="7" Text="Телефон:" FontWeight="Bold" Margin="20,5,0,5"/>
        <TextBox Grid.Column="1" Grid.Row="8" Text="{Binding ParentPhone, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="1" Grid.Row="9" Text="Место жительства:" FontWeight="Bold" Margin="20,5,0,5"/>
        <TextBox Grid.Column="1" Grid.Row="10" Text="{Binding ParentLivingPlace, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="1" Grid.Row="11" Text="Дата рождения:" FontWeight="Bold" Margin="20,5,0,5"/>
        <DatePicker Grid.Column="1" Grid.Row="12" SelectedDate="{Binding ParentBirthDate}" 
                    Margin="20,0,0,10" Width="250" HorizontalAlignment="Left"/>

        <!-- Кнопки -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="13" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,20">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" 
                    Width="120" Height="35" Margin="5" 
                    Background="LightGreen" FontWeight="Bold"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}" 
                    Width="120" Height="35" Margin="5" 
                    Background="LightCoral" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="14" 
                   Text="{Binding StatusMessage}" 
                   Foreground="{Binding StatusColor}" 
                   HorizontalAlignment="Center" Margin="10"/>
    </Grid>
</Window>