<UserControl x:Class="KidsOrganizationApp.UI.View.FamilyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Дети" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}" Height="430" BorderBrush="#D9E2F2">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock FontWeight="SemiBold"><Run Text="{Binding Surname}"/><Run Text=" "/><Run Text="{Binding Name}"/></TextBlock><TextBlock Text="{Binding DateBirth, StringFormat=Дата рождения: {0:dd.MM.yyyy}}" FontSize="11" Foreground="#667085"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Добавить ребёнка" Command="{Binding AddChildCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Родители выбранного ребёнка" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Parents}" SelectedItem="{Binding SelectedParent}" Height="430" BorderBrush="#D9E2F2">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock FontWeight="SemiBold"><Run Text="{Binding Surname}"/><Run Text=" "/><Run Text="{Binding Name}"/></TextBlock><TextBlock Text="Родитель" FontSize="11" Foreground="#667085"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Добавить родителя" Command="{Binding AddParentCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
        </StackPanel>
        <Border Grid.Column="3" Background="{DynamicResource ContentBackground}" BorderBrush="#E1E7F2" BorderThickness="1" CornerRadius="10" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Карточка" Style="{StaticResource SectionTitle}"/>
                <StackPanel Visibility="{Binding SelectedChildVisibility}">
                    <TextBlock Text="Ребёнок" FontSize="14" FontWeight="SemiBold" Foreground="#315EA8"/>
                    <TextBlock FontSize="23" FontWeight="SemiBold" Margin="0,6,0,20"><Run Text="{Binding SelectedChild.Surname}"/><Run Text=" "/><Run Text="{Binding SelectedChild.Name}"/><Run Text=" "/><Run Text="{Binding SelectedChild.Patronymic}"/></TextBlock>
                    <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedChild.DateBirth, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedChild.MobileNumber}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Место жительства" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedChild.LivingPlace}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedChild.Email}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding SelectedParentVisibility}" Margin="0,24,0,0">
                    <TextBlock Text="Выбранный родитель" FontSize="14" FontWeight="SemiBold" Foreground="#315EA8"/>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,6,0,12"><Run Text="{Binding SelectedParent.Surname}"/><Run Text=" "/><Run Text="{Binding SelectedParent.Name}"/><Run Text=" "/><Run Text="{Binding SelectedParent.Patronymic}"/></TextBlock>
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedParent.MobileNumber}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedParent.DateBirth, StringFormat={}{0:dd.MM.yyyy}}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Место жительства" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedParent.LivingPlace}" Style="{StaticResource FieldValue}"/>
                    <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SelectedParent.Email}" Style="{StaticResource FieldValue}"/>
                </StackPanel>
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="{Binding DocumentsTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#315EA8"/>
                    <ListBox ItemsSource="{Binding AttachedDocuments}" SelectedItem="{Binding SelectedDocument}" DisplayMemberPath="Path" Height="120" Margin="0,8,0,8"/>
                    <StackPanel Orientation="Horizontal"><Button Content="Добавить файл" Command="{Binding AddDocumentCommand}" Margin="0,0,8,0"/><Button Content="Открыть файл" Command="{Binding OpenDocumentCommand}"/></StackPanel>
                </StackPanel>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
