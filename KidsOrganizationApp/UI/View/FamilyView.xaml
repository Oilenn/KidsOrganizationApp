<Window x:Class="KidsOrganizationApp.UI.View.FamilyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KidsOrganizationApp.UI.View"
        mc:Ignorable="d"
        Title="FamilyView" Height="450" Width="800">

    <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
        </Grid.ColumnDefinitions>

            <!-- Дети -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Дети" FontWeight="Bold"/>

                <ListBox ItemsSource="{Binding Children}"
                     SelectedItem="{Binding SelectedChild}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="Name"/>

                                    <Binding Path="Surname"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Добавить ребенка"
                    Command="{Binding AddChildCommand}"/>
            </StackPanel>

            <!-- Родители -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Родители" FontWeight="Bold"/>

            <ListBox ItemsSource="{Binding Parents}"
                     SelectedItem="{Binding SelectedParent}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Добавить родителя"
                    Command="{Binding AddParentCommand}"/>
            </StackPanel>

        <StackPanel Grid.Column="2" Margin="10">
            <TextBlock Text="Информация" FontWeight="Bold" FontSize="16"/>

            <!-- Ребенок -->
            <StackPanel Visibility="{Binding SelectedChild}">
                <TextBlock Text="Ребенок:" FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedChild.Name}"/>
                <TextBlock Text="{Binding SelectedChild.Surname}"/>
                <TextBlock Text="{Binding SelectedChild.Patronymic}"/>
                <TextBlock Text="{Binding SelectedChild.MobileNumber}"/>
                <TextBlock Text="{Binding SelectedChild.LivingPlace}"/>
                <TextBlock Text="{Binding SelectedChild.Email}"/>
            </StackPanel>

            <!-- Родитель -->
            <StackPanel Visibility="{Binding SelectedParent}">
                <TextBlock Text="Родитель:" FontWeight="Bold"/>

                <TextBlock Text="{Binding SelectedParent.Name}"/>
                <TextBlock Text="{Binding SelectedParent.Surname}"/>
                <TextBlock Text="{Binding SelectedParent.Patronymic}"/>
                <TextBlock Text="{Binding SelectedParent.MobileNumber}"/>
                <TextBlock Text="{Binding SelectedParent.LivingPlace}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </Window>
