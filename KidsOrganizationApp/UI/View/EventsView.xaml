<UserControl x:Class="KidsOrganizationApp.UI.View.EventsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Новое мероприятие" Style="{StaticResource SectionTitle}"/><TextBlock Text="Название"/><TextBox Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/><TextBlock Text="Дата"/><DatePicker SelectedDate="{Binding EventDate}" Margin="0,5,0,12"/><Button Content="Добавить мероприятие" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="{Binding StatusMessage}" Foreground="#B42318" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Мероприятия" Style="{StaticResource SectionTitle}"/><DataGrid Margin="0,38,0,0" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="Документы выбранного мероприятия" FontWeight="SemiBold" Margin="0,16,0,6"/><ListBox Grid.Row="2" ItemsSource="{Binding AttachedDocuments}" SelectedItem="{Binding SelectedDocument}" DisplayMemberPath="Path"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Добавить файл" Command="{Binding AddDocumentCommand}" Margin="0,0,8,0"/><Button Content="Открыть файл" Command="{Binding OpenDocumentCommand}"/></StackPanel></Grid>
    </Grid>
</UserControl>
