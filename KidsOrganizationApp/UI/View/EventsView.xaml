<UserControl x:Class="KidsOrganizationApp.UI.View.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Новое мероприятие" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Название" />
            <TextBox Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" />
            <TextBlock Text="Дата" />
            <DatePicker SelectedDate="{Binding EventDate}" Margin="0,5,0,12" />
            <Button Content="Добавить мероприятие" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource ErrorText}"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="108" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Мероприятия" Style="{StaticResource SectionTitle}" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Документы выбранного мероприятия"
                       FontWeight="SemiBold" Margin="0,16,0,6" />
            <Grid Grid.Row="3">
                <ListBox ItemsSource="{Binding AttachedDocuments}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemTemplate="{StaticResource DocumentIconTemplate}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="{Binding EventDocumentsEmptyMessage}"
                           Visibility="{Binding EventDocumentsEmptyVisibility}"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DocumentStatusMessage}" Foreground="{DynamicResource ErrorText}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Добавить файл" Command="{Binding AddDocumentCommand}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
