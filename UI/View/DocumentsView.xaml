<UserControl x:Class="KidsOrganizationApp.UI.View.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnFilesDropped">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Новый документ" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Тип документа" />
            <ComboBox ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedDocumentType}" Margin="0,5,0,12" />
            <TextBlock Text="Кому принадлежит" />
            <ComboBox ItemsSource="{Binding OwnerTypes}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedOwnerType}" Margin="0,5,0,12" />
            <TextBlock Text="Запись" />
            <ComboBox ItemsSource="{Binding Owners}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedOwner}" Margin="0,5,0,12" />
            <TextBlock Text="Файл документа" />
            <Border Margin="0,5,0,12" Padding="10"
                    Background="{DynamicResource ContentBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                    AllowDrop="True" Drop="OnFilesDropped">
                <StackPanel>
                    <TextBlock Text="Перетащите файл сюда" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button Content="Выбрать файл" Command="{Binding SelectFileCommand}"
                                DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DocumentPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Button Content="Добавить документ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Все документы" Style="{StaticResource SectionTitle}" />
                <Button Grid.Column="1" Content="Открыть папку документов"
                        Command="{Binding OpenDocumentsFolderCommand}"
                        VerticalAlignment="Top" />
            </Grid>
            <Grid Grid.Row="1">
                <ListBox ItemsSource="{Binding Documents}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemTemplate="{StaticResource DocumentIconTemplate}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="Документы отсутствуют"
                           Visibility="{Binding DocumentsEmptyVisibility}"
                           Foreground="{DynamicResource SecondaryText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
